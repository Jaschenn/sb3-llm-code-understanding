classDiagram
    direction LR
    class Env["gymnasium.Env"] {
        +reset()
        +step()
    }
    class Monitor {
        +reset()
        +step()
    }
    class DummyVecEnv {
        -envs
        +reset()
        +step_wait()
    }
    class BaseAlgorithm {
        +env
        +policy
        +num_timesteps
        -_logger
        +predict()
    }
    class OnPolicyAlgorithm {
        +rollout_buffer
        +collect_rollouts()
    }
    class OffPolicyAlgorithm {
        +replay_buffer
    }
    class ActorCriticPolicy {
        +action_dist
        +features_extractor
        +mlp_extractor
        +action_net
        +value_net
        +optimizer
    }
    class RolloutBuffer
    class ReplayBuffer
    class Distribution {
        +sample()
        +mode()
        +log_prob()
        +entropy()
    }
    class BaseCallback {
        +init_callback()
        +on_step()
        +on_rollout_start()
        +on_rollout_end()
    }
    class Logger {
        +record()
        +dump()
    }

    DummyVecEnv *-- Env : envs
    Monitor ..> Env : 包装
    BaseAlgorithm o-- DummyVecEnv : env（VecEnv）
    BaseAlgorithm *-- ActorCriticPolicy : policy（PPO/A2C）
    OnPolicyAlgorithm *-- RolloutBuffer : rollout_buffer
    OffPolicyAlgorithm *-- ReplayBuffer : replay_buffer
    ActorCriticPolicy *-- Distribution : action_dist
    BaseAlgorithm o-- Logger : _logger
    OnPolicyAlgorithm ..> BaseCallback : 调用钩子
    OnPolicyAlgorithm ..> ActorCriticPolicy : forward / predict_values
